{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" }
  ],
  "redirects": [
    { "source": "/", "destination": "/login", "permanent": false }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/src/**"
    }
  }
}
