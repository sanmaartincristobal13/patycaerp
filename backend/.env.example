# Copiar este archivo como ".env" y completar los valores.
# El archivo .env NO se sube a git.

# Conexión a PostgreSQL
DATABASE_URL=postgres://usuario:clave@localhost:5432/patyca

# Clave para firmar las sesiones (texto largo y aleatorio).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Duración de la sesión
JWT_EXPIRA=12h

PORT=3000

# Primer usuario administrador (solo se usa en "npm run db:init")
ADMIN_EMAIL=patricia@patyca.cl
ADMIN_NOMBRE=Patricia Norambuena
ADMIN_PASSWORD=
