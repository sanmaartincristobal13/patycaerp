{
  "name": "patyca-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST del ERP PATYCA (Express + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:init": "node --env-file=.env scripts/db.js init",
    "db:reset": "node --env-file=.env scripts/db.js reset",
    "db:demo": "node --env-file=.env scripts/demo.js",
    "db:pesos": "node --env-file=.env scripts/importar-pesos.js",
    "portatil": "node scripts/crear-portatil.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
